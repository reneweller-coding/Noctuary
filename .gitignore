build/
build-*/
out/
.vs/
*.user
*.wav
__pycache__/
ThirdParty/*
# ...except the one library that is vendored rather than fetched: a single public-domain header
# the core needs to read FLAC. Git never descends into an excluded directory, so the pattern above
# excludes the CONTENTS and these two lines let one folder back in. Without the header in the repo
# nobody but this machine can build -- which is exactly what CI said, three red jobs in a row.
!ThirdParty/dr_libs/
!ThirdParty/dr_libs/*.h
*.keystore
Textures/
Tools/TextureGen/.venv/
__pycache__/
Wavetables/
Impulses/
Library/Textures/
Library/FieldRecordings/
Library/Wavetables/
Library/WavetablesNew/
Library/*.log
Tools/library/texture_jobs.json
Library/Impulses/
# The archive of recordings the near layer plays (NASA, public domain): fetched by
# Tools/library/fetch_archive.py, listed in Library/Archive/SOURCES.md, which stays in git; the
# audio travels in the content package like the rest of the library.
Library/Archive/**/*.flac
Library/Archive/**/*.mp3
Library/Archive/**/*.m4a

# Stray working folders from earlier tool runs; the real library lives under Library/.
/ambient.wav
/build-android/
/build-noavx/
Deploy/stage/
Deploy/out/
Deploy/content/
docs/manual/
Deploy/manual-work/
Tools/library/texture_retry.json
Tools/library/field_jobs.json
Tools/library/field_report.json
Scratch/

# Build- und Installationsprotokolle: Ergebnisse eines Laufs, nicht Quelltext
Deploy/*.log
Deploy/*.err
Deploy/out-old/
# The family's layout (01.10.2026): bin/<preset> what can be started, dist/ what is handed out,
# work/ local data, renders and logs (cmake/Family.cmake).
bin/
dist/
work/
