# The library's stamp (20.11.2026), run as a script at configure time and before every build of the core:
#
#   cmake -DPACKS=<repo>/Library/Packs -DHEADER=<build>/generated/ambient/LibraryStamp.h -P cmake/LibraryStamp.cmake
#
# Why: Rene played for weeks with a program built on 13.11. while it read the packs of 14.09. out of
# C:\ProgramData\Noctuary\Packs -- the exe started without Tools/play.ps1 reads the installed copies, not the tree's --
# and nothing anywhere said so. Since then the packs folder carries `library.stamp` (a date and a hash of the packs),
# the program carries the stamp of the library it was built with, and on loading it compares the two
# (Core/src/PresetPacks.cpp, libraryStatus()) and says it in the status line when the loaded one is older.
#
# The stamp is kept here, by the build, and not by the tools that write packs: there are more than thirty of those
# (Tools/library), and a stamp that one of them forgot would be worse than none. This hashes every *.ambientpack
# (SHA-1 of each file's bytes, then of the sorted list of names and hashes -- the packs are checked in with CRLF and
# no conversion, so a clone hashes the same) and rewrites `library.stamp` only when the hash has changed, dated with
# the newest pack's modification time (UTC). It writes the generated header only when its text changes, so an unchanged library recompiles nothing.
# A tree without packs (a build without the library) gets an empty stamp, and the program then never warns.
if(NOT PACKS OR NOT HEADER)
    message(FATAL_ERROR "LibraryStamp.cmake: PACKS and HEADER must be set")
endif()
file(GLOB _packs "${PACKS}/*.ambientpack")
list(SORT _packs)
list(LENGTH _packs _count)
set(_list "")
foreach(_p IN LISTS _packs)
    file(SHA1 "${_p}" _h)
    get_filename_component(_n "${_p}" NAME)
    string(APPEND _list "${_n} ${_h}\n")
endforeach()
set(_hash "")
set(_date "")
if(_count GREATER 0)
    string(SHA1 _hash "${_list}")
    set(_stamp "${PACKS}/library.stamp")
    set(_oldHash "")
    if(EXISTS "${_stamp}")
        file(STRINGS "${_stamp}" _lines)
        foreach(_l IN LISTS _lines)
            if(_l MATCHES "^hash=(.*)$")
                set(_oldHash "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^date=(.*)$")
                set(_date "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endif()
    if(NOT _oldHash STREQUAL _hash OR _date STREQUAL "")
        set(_date "")   # the newest pack's time: when the library last changed, not when the build ran
        foreach(_p IN LISTS _packs)
            file(TIMESTAMP "${_p}" _t "%Y-%m-%d %H:%M" UTC)
            if(_t STRGREATER _date)
                set(_date "${_t}")
            endif()
        endforeach()
        file(WRITE "${_stamp}"
             "# Noctuary library stamp: when these packs last changed (UTC) and a hash of them. Written by the build\n"
             "# (cmake/LibraryStamp.cmake) whenever the packs change; copy it along with the packs. The program compares it\n"
             "# with the stamp it was built with and says so in its status line when this library is older.\n"
             "date=${_date}\n"
             "packs=${_count}\n"
             "hash=${_hash}\n")
        message(STATUS "library.stamp: ${_count} packs, ${_date}")
    endif()
endif()
set(_text "/**
 * @file LibraryStamp.h
 * @brief Generated by cmake/LibraryStamp.cmake: the stamp of the library this program was built with.
 * @author Rene Weller
 */
#pragma once
/** @brief When the tree's packs last changed (UTC, \"YYYY-MM-DD hh:mm\"), or empty when the tree had none. */
#define AMBIENT_LIBRARY_DATE \"${_date}\"
/** @brief The hash of the tree's packs (cmake/LibraryStamp.cmake), or empty. */
#define AMBIENT_LIBRARY_HASH \"${_hash}\"
")
get_filename_component(_dir "${HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${_dir}")
file(WRITE "${HEADER}.tmp" "${_text}")
file(COPY_FILE "${HEADER}.tmp" "${HEADER}" ONLY_IF_DIFFERENT)
file(REMOVE "${HEADER}.tmp")
