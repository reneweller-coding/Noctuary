# Doxygen configuration for Noctuary. Run from the repository root:
#     doxygen docs/Doxyfile
# and open build/doxygen/html/index.html. Same layout as Phosphene's docs/Doxyfile.
PROJECT_NAME           = Noctuary
PROJECT_NUMBER         = 2.0.3
PROJECT_BRIEF          = "Generative ambient instrument"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = Core/include Core/src Plugin Quest/src Tools/render Tests README.md
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = Tests/neonshim
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
INPUT_ENCODING         = UTF-8
